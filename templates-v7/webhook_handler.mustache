<?php

{{>partial_header}}
namespace {{modelPackage}};

/**
 * Handler for processing {{serviceName}}.
 *
 * This class provides functionality to deserialize the payload of {{serviceName}} events.
 */
class {{serviceName}}Handler
{
    /**
     * The raw JSON payload from the webhook
     *
     * @var string
     */
    private $payload;

    /**
     * The webhook models that this handler can deserialize
     */
    private const WEBHOOK_CLASSES = [
{{#models}}{{#model.vendorExtensions.x-webhook-root}}        {{model.name}}::class,
{{/model.vendorExtensions.x-webhook-root}}{{/models}}    ];

    /**
     * Maps webhook event types to model classes, built once per process on first use
     *
     * @var array<string, string>|null
     */
    private static $typeClassMap = null;

    /**
     * Constructs a new handler for the given webhook payload
     *
     * @param string $payload the raw JSON payload from the webhook
     */
    public function __construct(string $payload)
    {
        $this->payload = $payload;
    }

    /**
     * Gets the webhook model for whichever event type the payload carries
     *
     * @return object|null the deserialized webhook model, or null if the payload cannot
     *                     be matched or parsed
     */
    public function getGenericWebhook(): ?object
    {
        $class = $this->resolveWebhookClass();

        if ($class === null) {
            return null;
        }

        return $this->deserializeField($class);
    }
{{#models}}{{#model.vendorExtensions.x-webhook-root}}
    /**
     * Gets the {{model.name}} from the webhook payload
     *
     * @return {{model.name}}|null the deserialized webhook model, or null if the payload
     *                             is a different event type or cannot be parsed
     */
    public function get{{model.name}}(): ?{{model.name}}
    {
        $class = $this->resolveWebhookClass();

        if ($class !== {{model.name}}::class) {
            return null;
        }

        return $this->deserializeField($class);
    }
{{/model.vendorExtensions.x-webhook-root}}{{/models}}
    /**
     * Decodes the payload, reads its `type` attribute, and returns the matching webhook class
     *
     * @return string|null the webhook model class name, or null if the payload is not valid
     *                     JSON, has no `type` attribute, or carries an unknown event type
     */
    private function resolveWebhookClass(): ?string
    {
        $jsonPayload = json_decode($this->payload, true);

        if (!is_array($jsonPayload)) {
            error_log("Could not parse {{serviceName}}Handler webhook payload: invalid JSON");
            return null;
        }

        if (!isset($jsonPayload['type'])) {
            error_log("Could not parse {{serviceName}}Handler webhook payload: 'type' attribute not found");
            return null;
        }

        if (!is_string($jsonPayload['type'])) {
            error_log("Could not parse {{serviceName}}Handler webhook payload: 'type' attribute is not a string");
            return null;
        }

        $class = self::findWebhookClass($jsonPayload['type']);

        if ($class === null) {
            error_log(
                "Could not parse {{serviceName}}Handler webhook payload: unknown webhook type '"
                . $jsonPayload['type'] . "'"
            );
            return null;
        }

        return $class;
    }

    /**
     * Returns the webhook class for the given event type
     *
     * The type to class map is built once per process on first use, from the immutable
     * WEBHOOK_CLASSES list, and reused for every subsequent lookup.
     *
     * @param string $type the webhook event type
     *
     * @return string|null the webhook model class name, or null if the event type is unknown
     */
    private static function findWebhookClass(string $type): ?string
    {
        if (self::$typeClassMap === null) {
            $map = [];
            foreach (self::WEBHOOK_CLASSES as $class) {
                $instance = new $class();
                foreach ($instance->getTypeAllowableValues() as $typeValue) {
                    $map[$typeValue] = $class;
                }
            }
            self::$typeClassMap = $map;
        }

        return self::$typeClassMap[$type] ?? null;
    }

    /**
     * Deserializes the payload into the specified class
     *
     * @param string $class the class to deserialize into
     *
     * @return object|null the deserialized webhook model, or null if an error occurs
     */
    private function deserializeField(string $class): ?object
    {
        try {
            return ObjectSerializer::deserialize($this->payload, $class);
        } catch (\Throwable $e) {
            // an error has occurred during deserialization (object not found, deserialization error)
            error_log("Object not found or unexpected error trying to access: " . $class);
            error_log("Deserialization error: " . $e->getMessage());
            return null;
        }
    }
}
